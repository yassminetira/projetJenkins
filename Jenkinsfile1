pipeline {
    agent any
    
    options {
        timestamps()
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '=== Étape 1 : Récupération du code source ==='
                git url: 'https://github.com/yassminetira/projetJenkins.git', branch: 'main'
            }
        }
        
        stage('Build') {
            steps {
                echo '=== Étape 2 : Construction (Build) ==='
                bat 'echo Compilation et préparation des fichiers du projet...'
            }
        }
        
        stage('Test - Vérifier h1') {
            steps {
                echo '=== Étape 3 : Lancement des tests (Recherche de <h1>) ==='
                // Utilisation de findstr sous Windows pour chercher la balise h1 dans les fichiers .html
                bat 'findstr /si "<h1" *.html'
                echo 'Test réussi : Une balise h1 a été trouvée !'
            }
        }
        
        stage('Delivery') {
            steps {
                echo '=== Étape 4 : Livraison (Delivery) ==='
                bat 'echo Le livrable est prêt et déployé avec succès.'
            }
        }
    }
    
    post {
        success {
            echo 'Pipeline exécuté avec succès (Build OK)'
        }
        failure {
            echo 'Le pipeline a échoué (Build KO - Aucune balise h1 trouvée ou erreur)'
        }
    }
}
